<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qykj.finmaster.task.mapper.TaskItemConfigMapper">
    
    <resultMap type="com.qykj.finmaster.task.domain.TaskItemConfig" id="TaskItemConfigResult">
        <id property="id" column="id"/>
        <result property="itemCode" column="item_code"/>
        <result property="itemName" column="item_name"/>
        <result property="itemType" column="item_type"/>
        <result property="handlerRole" column="handler_role"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectTaskItemConfigVo">
        select id, item_code, item_name, item_type, handler_role, sort_order, status, create_time
        from task_item_config
    </sql>

    <select id="selectTaskItemConfigList" parameterType="com.qykj.finmaster.task.domain.TaskItemConfig" resultMap="TaskItemConfigResult">
        <include refid="selectTaskItemConfigVo"/>
        <where>
            <if test="itemCode != null and itemCode != ''">
                AND item_code = #{itemCode}
            </if>
            <if test="itemName != null and itemName != ''">
                AND item_name like concat('%', #{itemName}, '%')
            </if>
            <if test="itemType != null and itemType != ''">
                AND item_type = #{itemType}
            </if>
            <if test="handlerRole != null and handlerRole != ''">
                AND handler_role = #{handlerRole}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by sort_order asc
    </select>

    <select id="selectTaskItemConfigByRole" parameterType="String" resultMap="TaskItemConfigResult">
        <include refid="selectTaskItemConfigVo"/>
        where handler_role = #{handlerRole}
        and status = '1'
        order by sort_order asc
    </select>

    <select id="selectTaskItemConfigByCode" parameterType="String" resultMap="TaskItemConfigResult">
        <include refid="selectTaskItemConfigVo"/>
        where item_code = #{itemCode}
        limit 1
    </select>

    <insert id="insertTaskItemConfig" parameterType="com.qykj.finmaster.task.domain.TaskItemConfig" useGeneratedKeys="true" keyProperty="id">
        insert into task_item_config (
            item_code, item_name, item_type, handler_role, sort_order, status, create_time
        ) values (
            #{itemCode}, #{itemName}, #{itemType}, #{handlerRole}, #{sortOrder}, #{status}, now()
        )
    </insert>

    <update id="updateTaskItemConfig" parameterType="com.qykj.finmaster.task.domain.TaskItemConfig">
        update task_item_config
        <set>
            <if test="itemCode != null">item_code = #{itemCode},</if>
            <if test="itemName != null">item_name = #{itemName},</if>
            <if test="itemType != null">item_type = #{itemType},</if>
            <if test="handlerRole != null">handler_role = #{handlerRole},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        where id = #{id}
    </update>

</mapper> 