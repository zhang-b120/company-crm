<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qykj.finmaster.system.user.mapper.UserDepartmentMapper">

    <select id="findDepartmentIdsByUserId" resultType="java.lang.Long">
        SELECT department_id
        FROM sys_user_department
        WHERE user_id = #{userId}
        AND deleted = 0
    </select>

    <update id="deleteByUserId">
        UPDATE sys_user_department
        SET deleted = 1
        WHERE user_id = #{userId}
    </update>

    <insert id="insertBatch">
        INSERT INTO sys_user_department (user_id, department_id,tenant_id)
        VALUES
        <foreach collection="departmentIds" item="departmentId" separator=",">
            (#{userId}, #{departmentId},#{tenantId})
        </foreach>
    </insert>

</mapper>
