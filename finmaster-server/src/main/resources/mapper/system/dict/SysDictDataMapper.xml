<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qykj.finmaster.system.dict.mapper.SysDictDataMapper">
    
    <resultMap type="com.qykj.finmaster.system.dict.entity.SysDictData" id="SysDictDataResult">
        <id     property="id"           column="id"            />
        <result property="typeId"       column="type_id"       />
        <result property="label"        column="label"         />
        <result property="value"        column="value"         />
        <result property="sort"         column="sort"          />
        <result property="status"       column="status"        />
        <result property="remark"       column="remark"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
    </resultMap>
    
    <sql id="selectDictDataVo">
        select id, type_id, label, value, sort, status, remark, create_by, create_time, update_by, update_time
        from sys_dict_data
    </sql>
    
    <select id="selectByTypeId" parameterType="Long" resultMap="SysDictDataResult">
        <include refid="selectDictDataVo"/>
        where type_id = #{typeId}
        order by sort asc
    </select>
    
    <select id="selectByTypeAndLabel" resultMap="SysDictDataResult">
        <include refid="selectDictDataVo"/>
        where type_id in (select id from sys_dict_type where code = #{dictType})
        and label = #{dictLabel}
        limit 1
    </select>
    <select id="getDictDataListByTypeCode" resultMap="SysDictDataResult">
        SELECT
            sd.label,
            sd.value,
            sd.sort,
            sd.status,
            sd.remark
        FROM sys_dict_data sd
        LEFT JOIN sys_dict_type st on sd.type_id = st.id
        WHERE 1=1
            <if test="code != null and code != ''">
               AND st.code = #{code}
            </if>
        ORDER BY sd.sort asc
    </select>
    <select id="getDictDataListByTypeCodeList"
            resultType="com.qykj.finmaster.system.dict.entity.resp.GetDictDataListResp">
        SELECT
        sd.label,
        sd.value,
        sd.sort,
        sd.status,
        sd.remark,
        st.code as typeCode
        FROM sys_dict_data sd
        LEFT JOIN sys_dict_type st on sd.type_id = st.id
        WHERE 1=1 AND st.code in
        <foreach item="item" collection="codeList" open="(" separator="," close=")">
             #{item}
        </foreach>
        ORDER BY sd.sort asc

    </select>

</mapper>