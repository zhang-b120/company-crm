<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qykj.finmaster.order.mapper.OrderDetailMapper">
    
    <resultMap type="com.qykj.finmaster.order.domain.OrderDetail" id="OrderDetailResult">
        <id     property="id"           column="id"            />
        <result property="tenantId"     column="tenant_id"     />
        <result property="orderId"      column="order_id"      />
        <result property="productId"    column="product_id"    />
        <result property="productName"  column="product_name"  />
        <result property="unitPrice"    column="unit_price"    />
        <result property="quantity"     column="quantity"      />
        <result property="discount"     column="discount"      />
        <result property="taxRate"      column="tax_rate"      />
        <result property="amount"       column="amount"        />
        <result property="specification" column="specification" />
        <result property="unit"         column="unit"          />
        <result property="effectiveDate" column="effective_date" />
        <result property="endDate"      column="end_date"      />
        <result property="createTime"   column="create_time"   />
        <result property="updateTime"   column="update_time"   />
        <result property="companyId"   column="company_id"   />
        <result property="orderDetailType" column="order_detail_type" />
        <result property="businessId"   column="business_id"   />
    </resultMap>

    <sql id="selectOrderDetailVo">
        select id, tenant_id, order_id, product_id, product_name, unit_price, quantity, discount, tax_rate, amount, specification, unit, effective_date, end_date, create_time, update_time, company_id, order_detail_type, business_id
        from order_details
    </sql>

    <select id="selectOrderDetailList" parameterType="com.qykj.finmaster.order.domain.OrderDetail" resultMap="OrderDetailResult">
        <include refid="selectOrderDetailVo"/>
        <where>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
        </where>
    </select>
    
    <select id="selectOrderDetailById" parameterType="Long" resultMap="OrderDetailResult">
        <include refid="selectOrderDetailVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertOrderDetail" parameterType="com.qykj.finmaster.order.domain.OrderDetail" useGeneratedKeys="true" keyProperty="id">
        insert into order_details
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tenantId != null">tenant_id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="productName != null">product_name,</if>
            <if test="unitPrice != null">unit_price,</if>
            <if test="quantity != null">quantity,</if>
            <if test="discount != null">discount,</if>
            <if test="taxRate != null">tax_rate,</if>
            <if test="amount != null">amount,</if>
            <if test="specification != null">specification,</if>
            <if test="unit != null">unit,</if>
            <if test="effectiveDate != null">effective_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="companyId != null">company_id,</if>
            <if test="orderDetailType != null">order_detail_type,</if>
            <if test="businessId != null">business_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tenantId != null">#{tenantId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productName != null">#{productName},</if>
            <if test="unitPrice != null">#{unitPrice},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="discount != null">#{discount},</if>
            <if test="taxRate != null">#{taxRate},</if>
            <if test="amount != null">#{amount},</if>
            <if test="specification != null">#{specification},</if>
            <if test="unit != null">#{unit},</if>
            <if test="effectiveDate != null">#{effectiveDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="companyId != null">#{companyId},</if>
            <if test="orderDetailType != null">#{orderDetailType},</if>
            <if test="businessId != null">#{businessId},</if>
         </trim>
    </insert>

    <insert id="batchInsertOrderDetail" parameterType="java.util.List">
        insert into order_details (tenant_id, order_id, product_id, product_name, unit_price, quantity, discount, tax_rate, amount, specification, unit, effective_date, end_date, create_time, update_time, company_id, order_detail_type, business_id)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.tenantId}, #{item.orderId}, #{item.productId}, #{item.productName}, #{item.unitPrice}, #{item.quantity}, #{item.discount}, #{item.taxRate}, #{item.amount}, #{item.specification}, #{item.unit}, #{item.effectiveDate}, #{item.endDate}, #{item.createTime}, #{item.updateTime}, #{item.companyId}, #{item.orderDetailType}, #{item.businessId})
        </foreach>
    </insert>

    <update id="updateOrderDetail" parameterType="com.qykj.finmaster.order.domain.OrderDetail">
        update order_details
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="unitPrice != null">unit_price = #{unitPrice},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="discount != null">discount = #{discount},</if>
            <if test="taxRate != null">tax_rate = #{taxRate},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="specification != null">specification = #{specification},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="effectiveDate != null">effective_date = #{effectiveDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="orderDetailType != null">order_detail_type = #{orderDetailType},</if>
            <if test="businessId != null">business_id = #{businessId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderDetailById" parameterType="Long">
        delete from order_details where id = #{id}
    </delete>

    <delete id="deleteOrderDetailByIds" parameterType="String">
        delete from order_details where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteOrderDetailByOrderId" parameterType="Long">
        delete from order_details where order_id = #{orderId}
    </delete>

    <!-- 统计正常订单下同租户、同公司（company_id IN 同税号公司ID）、同业务的订单明细条数；补款业务不参与：排除 excludeBusinessId -->
    <select id="countNormalOrderDetailsByCompanyAndBusiness" resultType="long">
        SELECT COUNT(1)
        FROM order_details d
        INNER JOIN orders o ON d.order_id = o.id
        WHERE o.order_type = 'NORMAL'
          AND o.status != 'CANCELLED'
          AND d.tenant_id = #{tenantId}
          AND d.business_id = #{businessId}
          <if test="excludeBusinessId != null">
          AND d.business_id != #{excludeBusinessId}
          </if>
          <if test="companyIds != null and companyIds.size() > 0">
          AND d.company_id IN
          <foreach collection="companyIds" item="id" open="(" separator="," close=")">#{id}</foreach>
          </if>
          <if test="companyIds == null or companyIds.size() == 0">
          AND 1 = 0
          </if>
    </select>
</mapper> 